# Environment files and secrets, at any depth (R-02).
# "*.env" also covers names like aws.env or creds.env, which ".env" alone misses.
.env
.env.*
*.env
!.env.example
# secrets/ holds SOPS ciphertext, which IS committed; anything else in it is not.
secrets/*
!secrets/*.enc.yaml
*.secret

# Private keys and certificates (the age key lives in ~/.config/sops/age/, never here)
keys.txt
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
certs/

# Claude Code per-user settings
.claude/settings.local.json

# OS and editor clutter
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Replay input for the local stack (Lab 5), never committed
data/
